# ---- Core ----------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_DOCS=false

# ---- Database (Neon) -------------------------------------------------------
# App: POOLED endpoint (host contains "-pooler"). Alembic: DIRECT endpoint.
DATABASE_URL=postgresql://app_user:CHANGE_ME@ep-xxxx-pooler.region.aws.neon.tech/vaultchat?sslmode=require
DATABASE_URL_DIRECT=postgresql://migrator:CHANGE_ME@ep-xxxx.region.aws.neon.tech/vaultchat?sslmode=require
DB_SSL=true

# ---- Clerk (Dashboard -> API Keys / Webhooks) -----------------------------------
CLERK_SECRET_KEY=sk_test_xxx
# Frontend API URL = the "iss" of session tokens, e.g. https://xxx-yy-12.clerk.accounts.dev
CLERK_ISSUER=
# Optional override; default is {CLERK_ISSUER}/.well-known/jwks.json
CLERK_JWKS_URL=
# Svix signing secret of the webhook endpoint https://<api>/api/v1/webhooks/clerk (events: user.*)
CLERK_WEBHOOK_SECRET=
# Defaults to ALLOWED_ORIGINS; checked against the token's "azp" claim
CLERK_AUTHORIZED_PARTIES=
CLERK_SYNC_TTL_SECONDS=300
CLERK_ADMIN_SYNC_TTL_SECONDS=60
# Where invited users land to finish sign-up (your frontend's sign-up page)
INVITATION_REDIRECT_URL=http://localhost:3000/sign-up

# ---- Web ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1
# Optional comma-separated IP addresses/CIDRs allowed to reach /admin (empty = no restriction)
ADMIN_IP_ALLOWLIST=

# ---- Policy ------------------------------------------------------------------
ALLOW_USER_GROUP_CREATION=true

# ---- Optional ----------------------------------------------------------------
# REQUIRED when running more than one instance/worker (shared rate limits + WS fan-out)
REDIS_URL=
SENTRY_DSN=
