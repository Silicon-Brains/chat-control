# Public (browser-exposed) — never put secrets here
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Clerk (admin sign-in / sign-up). The secret key is server-only — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Dev only: run without a backend (in-memory fake API, see README)
NEXT_PUBLIC_MOCK=false
